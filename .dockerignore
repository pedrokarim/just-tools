# Ce qui n'entre jamais dans le contexte de build.

# Secrets : aucun .env dans l'image, sous aucune forme.
.env
.env.*
!.env.example

# Exports de la base faits à la main (ignorés par git, mais présents sur le
# poste : un build local les enverrait dans le contexte).
scripts/backup-*.json

# Reconstruit dans l'image.
node_modules
.next
out

# Propre au poste.
.git
.claude
.vscode
.idea

# Sans rapport avec le site servi.
docs/local
coverage
temp
design
tests
tts-hotkey
*.log

# Docker lui-même.
Dockerfile
.dockerignore
docker-compose.yml
