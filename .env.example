# Configuration du projet Just Tools
# Copiez ce fichier vers .env.local et modifiez les valeurs selon vos besoins

# =============================================================================
# INFORMATIONS DE BASE
# =============================================================================

# Nom du site
NEXT_PUBLIC_SITE_NAME="Just Tools"

# Description du site
NEXT_PUBLIC_SITE_DESCRIPTION="Suite d'outils de développement gratuits"

# Version du projet : dérivée de package.json au build (scripts/version.js).
# Ne pas la fixer ici — utiliser APP_VERSION pour forcer une version en CI.

# =============================================================================
# URLs ET DOMAINES
# =============================================================================

# URL principale du site (production)
NEXT_PUBLIC_SITE_URL="https://just-tools.ascencia.re"

# URL de fallback (développement)
NEXT_PUBLIC_FALLBACK_URL="http://localhost:3000"

# =============================================================================
# CONTACT ET COMMUNICATION
# =============================================================================

# Email de contact
NEXT_PUBLIC_CONTACT_EMAIL="contact@ascencia.re"

# =============================================================================
# ENVIRONNEMENT
# =============================================================================

# Environnement (development, production, test)
NODE_ENV="development"

PORT=3000

# =============================================================================
# ANALYTICS ET MONITORING (optionnel)
# =============================================================================

# Google Analytics ID
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# =============================================================================
# FONCTIONNALITÉS AVANCÉES (optionnel)
# =============================================================================

# Activer les fonctionnalités expérimentales
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES="false"

# Limite de taille pour les uploads (en MB)
# NEXT_PUBLIC_MAX_UPLOAD_SIZE="10"

# =============================================================================
# NOTES
# =============================================================================

# - Toutes les variables commençant par NEXT_PUBLIC_ sont accessibles côté client
# - Les autres variables ne sont accessibles que côté serveur
# - Modifiez ces valeurs selon votre environnement de déploiement
# - N'oubliez pas de redémarrer le serveur après modification des variables d'environnement

# Configuration de base de données
# Pour SQLite (développement local)
# DATABASE_URL="file:./data/auth.db"


# Pour PostgreSQL (production, base Neon)
DATABASE_URL="postgresql://username:password@host:port/database?schema=public"
DIRECT_URL="postgresql://username:password@host:port/database?schema=public"
# Sarutobi — Product Analytics (https://sarutobi.ascencia.re)
# Identifiant de site, créé depuis le tableau de bord Sarutobi.
# Destiné au navigateur, ce n'est donc pas un secret — d'où le préfixe NEXT_PUBLIC_.
# Laissé vide, le SDK reste inerte : aucune requête n'est émise.
NEXT_PUBLIC_SARUTOBI_SITE_ID=""

# ── Ascencia ID ──────────────────────────────────────────────────────────────
#
# L'authentification est déléguée au fournisseur d'identité. Les trois valeurs
# se récupèrent dans la console, sur la fiche de l'application « just-tools ».
#
# Le secret n'est affiché **qu'une fois**, à la création : il n'est stocké que
# haché. S'il est perdu, il se fait tourner depuis la console, avec une période
# de grâce de 24 h pour que le déploiement suive.
ASCENCIA_ISSUER="https://id.ascencia.re"
NEXT_PUBLIC_ASCENCIA_ISSUER="https://id.ascencia.re"
ASCENCIA_CLIENT_ID=""
ASCENCIA_CLIENT_SECRET=""
# Facultatif : par défaut `${NEXT_PUBLIC_SITE_URL}/api/auth/callback`. À poser
# quand le site ne tourne pas sur le port du site — typiquement en local, où
# l'IdP occupe déjà 3000.
ASCENCIA_REDIRECT_URI=""

# `AUTHORIZED_USERS` n'est plus lu : l'autorisation vit dans Ascencia ID, sous
# forme de rôles attribués depuis la console. Ouvrir l'accès à quelqu'un ne
# demande plus de redéploiement.
